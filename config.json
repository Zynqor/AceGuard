{
  "processes": [
    {
      "name": "AceGuard.exe",
      "affinity": [0, 1],
      "priority": "IDLE",
      "comment": "限制AceGuard只使用2个CPU核心，并设置为最低优先级"
    },
    {
      "name": "EasyAntiCheat.exe",
      "affinity": [0, 1, 2, 3],
      "priority": "BELOW_NORMAL",
      "comment": "限制EasyAntiCheat使用4个核心，低于正常优先级"
    }
  ],
  "settings": {
    "monitor_interval": 5,
    "comment": "监控间隔（秒）"
  },
  "comment": "配置说明",
  "priority_options": [
    "IDLE - 空闲，仅在系统空闲时运行（推荐用于限制）",
    "BELOW_NORMAL - 低于正常",
    "NORMAL - 正常（默认）",
    "ABOVE_NORMAL - 高于正常",
    "HIGH - 高",
    "REALTIME - 实时（危险！可能导致系统不稳定）"
  ],
  "affinity_examples": {
    "only_first_core": [0],
    "first_two_cores": [0, 1],
    "first_four_cores": [0, 1, 2, 3],
    "even_cores": [0, 2, 4, 6],
    "odd_cores": [1, 3, 5, 7],
    "all_cores_except_first": [1, 2, 3, 4, 5, 6, 7]
  }
